                          ),
                          onPressed: () {
                            if (isLastPage) {
                              _showAuthModal(context);
                            } else {
                              _nextPage();
                            }
                          },
                          child: Text(
                            isLastPage ? l10n.btnStartAuth : l10n.btnNext,
                            style: const TextStyle(
                              fontSize: 16,
                              fontWeight: FontWeight.bold,
                            ),
