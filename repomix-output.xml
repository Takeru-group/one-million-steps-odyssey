import 'package:cloud_firestore/cloud_firestore.dart';

class UserModel {
  final String userId;
  final DateTime appStartDate;
  final DateTime stepFetchedAt;
  final String startEra;
  final int startYear;
  final int startMonth;
  final int startDay;
  final bool isCleared;
  final int gameMode;
  final int steps;
  final int totalSteps;
  final DateTime scheduledDeletionAt;
  final DateTime? lastArtifactUnlockedAt; // 👈 最終アーティファクト獲得日時
  final Map<String, Map<String, dynamic>> unlockedArtifacts;
  final Map<String, Map<String, dynamic>> unlockedEras;

  UserModel({
    required this.userId,
    required this.appStartDate,
    required this.stepFetchedAt,
    required this.startEra,
    required this.startYear,
    required this.startMonth,
    required this.startDay,
    required this.isCleared,
    required this.gameMode,
    required this.steps,
    required this.totalSteps,
    required this.scheduledDeletionAt,
    this.lastArtifactUnlockedAt,
    required this.unlockedArtifacts,
    required this.unlockedEras,
  });

  factory UserModel.fromDocument(String docId, Map<String, dynamic> doc) {
    DateTime parseDate(dynamic value) {
      if (value is Timestamp) {
        return value.toDate();
      } else if (value is String) {
        return DateTime.tryParse(value) ?? DateTime.now();
      }
      return DateTime.now();
    }

    DateTime? parseNullableDate(dynamic value) {
      if (value is Timestamp) return value.toDate();
      if (value is String) return DateTime.tryParse(value);
      return null;
    }

    Map<String, Map<String, dynamic>> parseMapData(dynamic rawData) {
      if (rawData is! Map) return {};
      final resultMap = <String, Map<String, dynamic>>{};

      rawData.forEach((key, value) {
        if (value is Map) {
          final itemMap = Map<String, dynamic>.from(value);
          if (itemMap['unlockedAt'] is String) {
            final parsedDt = DateTime.tryParse(itemMap['unlockedAt']);
            if (parsedDt != null) {
              itemMap['unlockedAt'] = Timestamp.fromDate(parsedDt);
            }
          }
          resultMap[key.toString()] = itemMap;
        }
      });
      return resultMap;
    }

    return UserModel(
      userId: docId,
      appStartDate: parseDate(doc['appStartDate']),
      stepFetchedAt: parseDate(doc['stepFetchedAt']),
      startEra: doc['startEra'] ?? '西暦',
      startYear: doc['startYear'] ?? 2026,
      startMonth: doc['startMonth'] ?? 1,
      startDay: doc['startDay'] ?? 1,
      isCleared: doc['isCleared'] ?? false,
      gameMode: doc['gameMode'] ?? 0,
      steps: doc['steps'] ?? 0,
      totalSteps: doc['totalSteps'] ?? 0,
      scheduledDeletionAt: parseDate(doc['scheduledDeletionAt']),
      lastArtifactUnlockedAt: parseNullableDate(doc['lastArtifactUnlockedAt']),
      unlockedArtifacts: parseMapData(doc['unlockedArtifacts']),
      unlockedEras: parseMapData(doc['unlockedEras']),
    );
  }

  Map<String, dynamic> toDocument() {
    return {
      'appStartDate': Timestamp.fromDate(appStartDate),
      'stepFetchedAt': Timestamp.fromDate(stepFetchedAt),
      'startEra': startEra,
      'startYear': startYear,
      'startMonth': startMonth,
      'startDay': startDay,
      'isCleared': isCleared,
      'gameMode': gameMode,
      'steps': steps,
      'totalSteps': totalSteps,
      'scheduledDeletionAt': Timestamp.fromDate(scheduledDeletionAt),
      if (lastArtifactUnlockedAt != null)
        'lastArtifactUnlockedAt': Timestamp.fromDate(lastArtifactUnlockedAt!),
      'unlockedArtifacts': unlockedArtifacts,
      'unlockedEras': unlockedEras,
    };
  }
}
