class HistoryView extends StatelessWidget {
  final UserDetailedData? detailedData;

  const HistoryView({
    super.key,
    required this.detailedData,
  });

  String _formatDate(dynamic date) {
    if (date == null) return '----/--/--';
    DateTime dt;
    if (date is DateTime) {
      dt = date.toLocal();
    } else {
      try {
        dt = (date as dynamic).toDate().toLocal();
      } catch (_) {
        return '----/--/--';
      }
    }
    return '${dt.year}/${dt.month.toString().padLeft(2, '0')}/${dt.day.toString().padLeft(2, '0')}';
  }

  /// 世紀のタイトル文字列を多言語対応で生成 (例: -1 ➔ 紀元前1世紀 / 1st century BCE)
  String _formatCenturyHeader(BuildContext context, int century) {
    final l10n = AppLocalizations.of(context)!;
    final isBce = century < 0;
    final absCentury = century.abs();

    // l10n に設定がある場合は優先、なければ直接生成
    if (isBce) {
      return '紀元前$absCentury世紀';
    } else {
      return '$absCentury世紀';
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final isDarkMode = Theme.of(context).brightness == Brightness.dark;
    final currentLocale = Localizations.localeOf(context).languageCode;

    if (detailedData == null) {
      return const Center(child: CircularProgressIndicator());
    }

    final user = detailedData!.user;
    final unlockedEras = user.unlockedEras;
    final unlockedArtifacts = user.unlockedArtifacts;

    // 世紀ごとにイベント（年代解放・アーティファクト獲得）をグループ化
    final Map<int, List<Map<String, dynamic>>> centuryGroups = {};

    // 1. 年代（Eras）イベントの追加
    unlockedEras.forEach((eraKey, eraData) {
      final century = (eraData['century'] as num?)?.toInt() ?? 1;
      final unlockedAt = eraData['unlockedAt'];
      final master = detailedData!.unlockedHistories[eraKey];

      // 🌟 master の yearLabelJp / yearLabelEn を最優先参照
      final label = master != null
          ? master.getYearLabel(currentLocale)
          : (eraData['eraLabel'] as String? ?? '');

      // メッセージ作成（英語/日本語で切り替え）
      final displayTitle = currentLocale == 'en'
          ? '$label reached'
          : '$labelに到達しました';

      final item = {
        'type': 'era',
        'id': eraKey,
        'unlockedAt': unlockedAt,
        'title': displayTitle,
        'master': master,
        'imagePath': master?.thumbnailPath ?? master?.backgroundImagePath ?? '',
      };

      centuryGroups.putIfAbsent(century, () => []).add(item);
    });

    // 2. アーティファクト（Artifacts）イベントの追加
    unlockedArtifacts.forEach((artifactId, artifactData) {
      final eraKey = artifactData['eraKey'] as String? ?? '';
      final masterEra = detailedData!.unlockedHistories[eraKey];
      final unlockedAt = artifactData['unlockedAt'];

      final artifactMaster = detailedData!.unlockedArtifacts[artifactId];
      if (artifactMaster == null) return;

      final century = artifactMaster.century;
      final artifactName = artifactMaster.getName(currentLocale);

      final displayTitle = currentLocale == 'en'
          ? 'Discovered $artifactName'
          : '$artifactNameを発見しました。';

      final item = {
        'type': 'artifact',
        'id': artifactId,
        'unlockedAt': unlockedAt,
        'title': displayTitle,
        'artifactMaster': artifactMaster,
        'imagePath': artifactMaster.thumbnailPath.isNotEmpty
            ? artifactMaster.thumbnailPath
            : artifactMaster.backgroundImagePath,
      };

      centuryGroups.putIfAbsent(century, () => []).add(item);
    });

    // 世紀の降順（新しい時代順：21世紀 -> 1世紀 -> 紀元前1世紀...）にソート
    final sortedCenturies = centuryGroups.keys.toList()
      ..sort((a, b) => b.compareTo(a));

    if (sortedCenturies.isEmpty) {
      return Center(
        child: Text(
          l10n.tabHistory,
          style: TextStyle(
            color: isDarkMode ? Colors.white70 : Colors.black54,
          ),
        ),
      );
    }

    final cardBgColor = isDarkMode
        ? Colors.black.withOpacity(0.40)
        : Colors.white.withOpacity(0.40);
    final borderColor = isDarkMode
        ? Colors.white.withOpacity(0.15)
        : Colors.white.withOpacity(0.50);
    final textColor = isDarkMode ? Colors.white : Colors.black87;
    final subTextColor = isDarkMode ? Colors.white70 : Colors.black54;

    return ListView.builder(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      itemCount: sortedCenturies.length,
      itemBuilder: (context, index) {
        final century = sortedCenturies[index];
        final items = centuryGroups[century]!;

        // 獲得日時（unlockedAt）の新しい順にソート
        items.sort((a, b) {
          final dtA = a['unlockedAt'];
          final dtB = b['unlockedAt'];
          if (dtA == null || dtB == null) return 0;
          try {
            return (dtB as dynamic).compareTo(dtA);
          } catch (_) {
            return 0;
          }
        });

        return Container(
          margin: const EdgeInsets.only(bottom: 16),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(20),
            child: BackdropFilter(
              filter: ImageFilter.blur(sigmaX: 12, sigmaY: 12),
              child: Container(
                decoration: BoxDecoration(
                  color: cardBgColor,
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(color: borderColor),
                ),
                child: Theme(
                  data: Theme.of(context).copyWith(
                    dividerColor: Colors.transparent,
                  ),
                  child: ExpansionTile(
                    initiallyExpanded: true,
                    title: Text(
                      _formatCenturyHeader(context, century),
                      style: TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                        color: textColor,
                      ),
                    ),
                    children: items.map((item) {
                      final title = item['title'] as String;
                      final unlockedAt = item['unlockedAt'];
                      final imagePath = item['imagePath'] as String;

                      return ListTile(
                        leading: ClipRRect(
                          borderRadius: BorderRadius.circular(8),
                          child: Container(
                            width: 48,
                            height: 48,
                            color: Colors.black12,
                            child: imagePath.isNotEmpty
                                ? Image.network(
                                    imagePath,
                                    fit: BoxFit.cover,
                                    errorBuilder: (_, __, ___) => const Icon(
                                      Icons.history_edu,
                                      color: Colors.white54,
                                    ),
                                  )
                                : const Icon(
                                    Icons.history_edu,
                                    color: Colors.white54,
                                  ),
                          ),
                        ),
                        title: Text(
                          _formatDate(unlockedAt),
                          style: TextStyle(
                            fontSize: 12,
                            color: subTextColor,
                          ),
                        ),
                        subtitle: Text(
                          title,
                          style: TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.w600,
                            color: textColor,
                          ),
                        ),
                        trailing: Icon(
                          Icons.chevron_right,
                          color: subTextColor,
                        ),
                        onTap: () {
                          // 詳細モーダル表示などのアクション（拡張可能）
                        },
                      );
                    }).toList(),
                  ),
                ),
              ),
            ),
          ),
        );
      },
    );
  }
}
