import 'package:flutter/foundation.dart';
import 'package:google_mobile_ads/google_mobile_ads.dart';

class AdManager {
  RewardedAd? _rewardedAd;
  bool _isAdLoading = false;

  /// テスト用リワード広告ユニットID (iOS / Android 自動判別)
  final String _adUnitId = kDebugMode
      ? (defaultTargetPlatform == TargetPlatform.iOS
          ? 'ca-app-pub-3940256099942544/1712485313' // iOS テストID
          : 'ca-app-pub-3940256099942544/5224354917') // Android テストID
      : 'ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY'; // 本番用ID

  /// 広告が再生可能かどうかのフラグ
  bool get isAdReady => _rewardedAd != null;

  /// リワード広告の事前読み込み (非同期)
  void loadRewardedAd({VoidCallback? onAdLoaded}) {
    // ⭕️ すでにロード済み、またはロード中の場合は重複リクエストを防止
    if (_rewardedAd != null) {
      print('ℹ️ [AdManager] すでに広告が準備できています。');
      onAdLoaded?.call();
      return;
    }
    if (_isAdLoading) {
      print('⏳ [AdManager] 現在広告をロード中です。重複リクエストをスキップします。');
      return;
    }

    _isAdLoading = true;
    print('🚀 [AdManager] 広告のロードを開始します... UnitID: $_adUnitId');

    RewardedAd.load(
      adUnitId: _adUnitId,
      request: const AdRequest(),
      rewardedAdLoadCallback: RewardedAdLoadCallback(
        onAdLoaded: (RewardedAd ad) {
          print('✅ [AdManager] 広告のロードに成功しました！');
          _rewardedAd = ad;
          _isAdLoading = false;
          _setupAdCallbacks();
          onAdLoaded?.call();
        },
        onAdFailedToLoad: (LoadAdError error) {
          print('❌ [AdManager] 広告のロードに失敗しました:');
          print('   ├ Domain: ${error.domain}');
          print('   ├ Code: ${error.code}');
          print('   └ Message: ${error.message}');
          _rewardedAd = null;
          _isAdLoading = false;
        },
      ),
    );
  }

  /// 広告表示中のライフサイクルコールバックを設定
  void _setupAdCallbacks() {
    if (_rewardedAd == null) return;

    _rewardedAd!.fullScreenContentCallback = FullScreenContentCallback(
      onAdShowedFullScreenContent: (RewardedAd ad) {
        print('📺 [AdManager] 広告が画面に表示されました。');
      },
      onAdImpression: (RewardedAd ad) {
        print('👁️ [AdManager] 広告インプレッション送信。');
      },

      /// 🚨 黒画面や表示失敗が発生した場合の完全安全処理
      onAdFailedToShowFullScreenContent: (RewardedAd ad, AdError error) {
        print('💥 [AdManager] ⚠️ 広告の表示中にエラーが発生しました（黒画面対策実行）:');
        print('   ├ Domain: ${error.domain}');
        print('   ├ Code: ${error.code}');
        print('   └ Message: ${error.message}');

        // リソース破棄とクリア
        ad.dispose();
        _rewardedAd = null;
        _isAdLoading = false;

        // 裏で再読み込み
        loadRewardedAd();
      },

      onAdDismissedFullScreenContent: (RewardedAd ad) {
        print('🚪 [AdManager] ユーザーが広告画面を閉じました。');
        ad.dispose();
        _rewardedAd = null;
        _isAdLoading = false;

        // 次回獲得用に裏で再読み込み
        loadRewardedAd();
      },

      onAdClicked: (RewardedAd ad) {
        print('👆 [AdManager] 広告がタップされました。');
      },
    );
  }

  /// 広告の再生実行
  void showRewardedAd({
    required Function onUserEarnedReward,
    Function(String reason)? onAdFailed,
  }) {
    if (_rewardedAd == null) {
      print('⚠️️ [AdManager] 表示可能な広告がありません。再ロードを実行します。');
      onAdFailed?.call('広告の読み込み中です。少々お待ちください。');
      loadRewardedAd();
      return;
    }

    print('🎬 [AdManager] 広告再生処理を実行します。');

    // 再生失敗時にも安全にコールバックを返せるようローカル参照を保護
    final ad = _rewardedAd!;
    _rewardedAd = null; // 2重再生防止のため一旦クリア

    ad.show(
      onUserEarnedReward: (AdWithoutView adView, RewardItem reward) {
        print('🎁 [AdManager] リワード獲得条件クリア！ (Type: ${reward.type}, Amount: ${reward.amount})');
        onUserEarnedReward();
      },
    );
  }

  /// リソースの破棄
  void dispose() {
    print('🧹 [AdManager] リソース破棄');
    _rewardedAd?.dispose();
    _rewardedAd = null;
    _isAdLoading = false;
  }
}
