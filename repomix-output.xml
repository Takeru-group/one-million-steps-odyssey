            newCentury != null
                ? '新しい時代「${eraLabel}年代」に到達し、$centuryTextに突入しました！\n背景と歴史情報が更新されます。'
                : '新しい時代「${eraLabel}年代」に到達しました！\n背景と歴史情報が更新されます。',
            style: TextStyle(color: textColor, fontSize: 14, height: 1.5),
