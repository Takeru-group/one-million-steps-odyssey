import 'dart:ui';
import 'package:flutter/material.dart';
import 'package:cached_network_image/cached_network_image.dart';
import 'package:firebase_auth/firebase_auth.dart';
import '../l10n/app_localizations.dart';
import '../utils/user_repository.dart';
import '../utils/master_data_repository.dart';
import 'app_bottom_sheet.dart';
class HistoryView extends StatefulWidget {
  final UserDetailedData? detailedData;
  const HistoryView({
    super.key,
    required this.detailedData,
  });
  @override
  State<HistoryView> createState() => _HistoryViewState();
}
class _HistoryViewState extends State<HistoryView> {
  /// 世紀ごとの開閉状態を保持するマップ (key: century, value: bool)
  final Map<int, bool> _expandedStates = {};
  String _formatDate(dynamic date) {
    if (date == null) return '----/--/--';
    DateTime dt;
    if (date is DateTime) {
      dt = date.toLocal();
    } else {
      try {
        dt = (date as dynamic).toDate().toLocal();
      } catch (_) {
        return '----/--/--';
      }
    }
    return '${dt.year}/${dt.month.toString().padLeft(2, '0')}/${dt.day.toString().padLeft(2, '0')}';
  }
  /// 世紀ヘッダーの多言語出力 (l10n参照)
  String _formatCenturyHeader(AppLocalizations l10n, int century) {
    final absCentury = century.abs();
    if (century < 0) {
      return l10n.historyCenturyBce(absCentury);
    } else {
      return l10n.historyCenturyCe(absCentury);
    }
  }
  /// 📜 タップ時のボトムシート表示（AppBottomSheet で共通化＆事前解決でカクつき防止）
  Future<void> _showDetailBottomSheet({
    required BuildContext context,
    required String title,
    required String description,
    required String imagePath,
    required dynamic unlockedAt,
    String? imageTitle,
    String? itemType,
    String? itemId,
  }) async {
    final langCode = Localizations.localeOf(context).languageCode;
    String resolvedImageTitle = imageTitle ?? '';
    // 🌟 画像タイトルが空の場合はマスターデータから事前に取得
    if (resolvedImageTitle.isEmpty && itemId != null && itemId.isNotEmpty) {
      final currentUserId = FirebaseAuth.instance.currentUser?.uid;
      if (itemType == 'era' && currentUserId != null) {
        final master = await UserRepository().fetchAndRepairEraMetadata(
          userId: currentUserId,
          eraKey: itemId,
        );
        if (master != null) {
          resolvedImageTitle = master.getTitle(langCode);
        }
      } else if (itemType == 'artifact') {
        final artifact = await MasterDataRepository().getArtifact(itemId);
        if (artifact != null) {
          resolvedImageTitle = artifact.getName(langCode);
        }
      } else {
        final master = await MasterDataRepository().getHistoryMaster(itemId);
        if (master != null) {
          resolvedImageTitle = master.getTitle(langCode);
        }
      }
    }
    if (!context.mounted) return;
    AppBottomSheet.show(
      context: context,
      title: title,
      subtitle: _formatDate(unlockedAt),
      description: description,
      imagePath: imagePath,
      imageTitle: resolvedImageTitle,
      showAiNotice: true,
    );
  }
  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final isDarkMode = Theme.of(context).brightness == Brightness.dark;
    final currentLocale = Localizations.localeOf(context).languageCode;
    if (widget.detailedData == null) {
      return const Center(child: CircularProgressIndicator());
    }
    final user = widget.detailedData!.user;
    final userGameMode = user.gameMode;
    final unlockedEras = user.unlockedEras;
    final unlockedArtifacts = user.unlockedArtifacts;
    final Map<int, List<Map<String, dynamic>>> centuryGroups = {};
    // 1. 年代（Eras）の処理
    unlockedEras.forEach((eraKey, eraData) {
      final eraGameMode = (eraData['gameMode'] as num?)?.toInt() ?? 0;
      if (eraGameMode != userGameMode) return;
      final century = (eraData['century'] as num?)?.toInt() ?? 1;
      final unlockedAt = eraData['unlockedAt'];
      final labelJp = eraData['yearLabelJp'] as String? ?? eraData['eraLabel'] as String? ?? '';
      final labelEn = eraData['yearLabelEn'] as String? ?? eraData['eraLabel'] as String? ?? '';
      final label = currentLocale == 'en' ? labelEn : labelJp;
      final descJp = eraData['descriptionJp'] as String? ?? '';
      final descEn = eraData['descriptionEn'] as String? ?? '';
      final description = currentLocale == 'en' ? descEn : descJp;
      final imageTitleJp = eraData['imageTitleJp'] as String? ?? '';
      final imageTitleEn = eraData['imageTitleEn'] as String? ?? '';
      final imageTitle = currentLocale == 'en'
          ? (imageTitleEn.isNotEmpty ? imageTitleEn : imageTitleJp)
          : imageTitleJp;
      final displayTitle = l10n.eraReachedMessage(label);
      final imagePath = eraData['thumbnailPath'] as String? ?? eraData['backgroundImagePath'] as String? ?? '';
      final fullImagePath = eraData['backgroundImagePath'] as String? ?? imagePath;
      final item = {
        'type': 'era',
        'id': eraKey,
        'unlockedAt': unlockedAt,
        'title': displayTitle,
        'description': description,
        'imagePath': imagePath,
        'fullImagePath': fullImagePath,
        'imageTitle': imageTitle,
      };
      centuryGroups.putIfAbsent(century, () => []).add(item);
    });
    // 2. アーティファクト（Artifacts）の処理
    unlockedArtifacts.forEach((artifactId, artifactData) {
      final artifactGameMode = (artifactData['gameMode'] as num?)?.toInt() ?? 0;
      if (artifactGameMode != userGameMode) return;
      final unlockedAt = artifactData['unlockedAt'];
      final nameJa = artifactData['nameJa'] as String? ?? '';
      final nameEn = artifactData['nameEn'] as String? ?? '';
      final artifactName = currentLocale == 'en' ? (nameEn.isNotEmpty ? nameEn : nameJa) : nameJa;
      final descJa = artifactData['descJa'] as String? ?? '';
      final descEn = artifactData['descEn'] as String? ?? '';
      final description = currentLocale == 'en' ? (descEn.isNotEmpty ? descEn : descJa) : descJa;
      final category = (artifactData['category'] as String? ?? '').toLowerCase();
      final century = (artifactData['century'] as num?)?.toInt() ?? 1;
      final imagePath = artifactData['thumbnailPath'] as String? ?? artifactData['backgroundImagePath'] as String? ?? '';
      final fullImagePath = artifactData['backgroundImagePath'] as String? ?? imagePath;
      final bool isPerson = category == 'figure' ||
          category == 'person' ||
          category == '偉人' ||
          category == '人物' ||
          category.contains('figure') ||
          category.contains('person');
      final displayTitle = isPerson
          ? l10n.figureMet(artifactName)
          : l10n.artifactDiscoveredMessage(artifactName);
      final item = {
        'type': 'artifact',
        'id': artifactId,
        'unlockedAt': unlockedAt,
        'title': displayTitle,
        'description': description,
        'imagePath': imagePath,
        'fullImagePath': fullImagePath,
        'imageTitle': artifactName,
      };
      centuryGroups.putIfAbsent(century, () => []).add(item);
    });
    final sortedCenturies = centuryGroups.keys.toList()
      ..sort((a, b) => b.compareTo(a));
    if (sortedCenturies.isEmpty) {
      return Center(
        child: Text(
          l10n.tabHistory,
          style: TextStyle(
            color: isDarkMode ? Colors.white70 : Colors.black54,
          ),
        ),
      );
    }
    final cardBgColor = isDarkMode
        ? Colors.black.withOpacity(0.40)
        : Colors.white.withOpacity(0.40);
    final borderColor = isDarkMode
        ? Colors.white.withOpacity(0.15)
        : Colors.white.withOpacity(0.50);
    final textColor = isDarkMode ? Colors.white : Colors.black87;
    final subTextColor = isDarkMode ? Colors.white70 : Colors.black54;
    return ListView.builder(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      itemCount: sortedCenturies.length,
      itemBuilder: (context, index) {
        final century = sortedCenturies[index];
        final items = centuryGroups[century]!;
        // デフォルトは一番最新の世紀のみ展開、それ以外は閉じた状態に初期化
        _expandedStates.putIfAbsent(century, () => index == 0);
        items.sort((a, b) {
          final dtA = a['unlockedAt'];
          final dtB = b['unlockedAt'];
          if (dtA == null || dtB == null) return 0;
          try {
            return (dtB as dynamic).compareTo(dtA);
          } catch (_) {
            return 0;
          }
        });
        return Container(
          margin: const EdgeInsets.only(bottom: 16),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(20),
            child: BackdropFilter(
              filter: ImageFilter.blur(sigmaX: 12, sigmaY: 12),
              child: Container(
                decoration: BoxDecoration(
                  color: cardBgColor,
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(color: borderColor),
                ),
                child: Material(
                  color: Colors.transparent,
                  child: Theme(
                    data: Theme.of(context).copyWith(
                      dividerColor: Colors.transparent,
                    ),
                    child: ExpansionTile(
                      // 🌟 世紀（century）ごとに固定Keyを渡して独立したStateを保持
                      key: PageStorageKey<int>(century),
                      initiallyExpanded: _expandedStates[century] ?? false,
                      onExpansionChanged: (bool isExpanded) {
                        setState(() {
                          _expandedStates[century] = isExpanded;
                        });
                      },
                      title: Text(
                        _formatCenturyHeader(l10n, century),
                        style: TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: textColor,
                        ),
                      ),
                      children: items.map((item) {
                        final title = item['title'] as String;
                        final description = item['description'] as String? ?? '';
                        final unlockedAt = item['unlockedAt'];
                        final imagePath = item['imagePath'] as String;
                        final fullImagePath = item['fullImagePath'] as String? ?? imagePath;
                        return ListTile(
                          leading: ClipRRect(
                            borderRadius: BorderRadius.circular(8),
                            child: Container(
                              width: 48,
                              height: 48,
                              color: Colors.black12,
                              child: imagePath.isNotEmpty
                                  ? Image.network(
                                      imagePath,
                                      fit: BoxFit.cover,
                                      errorBuilder: (_, __, ___) => const Icon(
                                        Icons.history_edu,
                                        color: Colors.white54,
                                      ),
                                    )
                                  : const Icon(
                                      Icons.history_edu,
                                      color: Colors.white54,
                                    ),
                            ),
                          ),
                          title: Text(
                            _formatDate(unlockedAt),
                            style: TextStyle(
                              fontSize: 12,
                              color: subTextColor,
                            ),
                          ),
                          subtitle: Text(
                            title,
                            style: TextStyle(
                              fontSize: 14,
                              fontWeight: FontWeight.w600,
                              color: textColor,
                            ),
                          ),
                          trailing: Icon(
                            Icons.chevron_right,
                            color: subTextColor,
                          ),
                          onTap: () {
                            _showDetailBottomSheet(
                              context: context,
                              title: title,
                              description: description,
                              imagePath: fullImagePath,
                              unlockedAt: unlockedAt,
                              imageTitle: item['imageTitle'] as String?,
                              itemType: item['type'] as String?,
                              itemId: item['id'] as String?,
                            );
                          },
                        );
                      }).toList(),
                    ),
                  ),
                ),
              ),
            ),
          ),
        );
      },
    );
  }
}
</file>

<file path="lib/widgets/home_view.dart">
import 'dart:ui';
import 'package:flutter/material.dart';
import 'package:firebase_auth/firebase_auth.dart';
import '../l10n/app_localizations.dart';
import '../models/history_master_model.dart';
import '../utils/timeline_calculator.dart';
import '../utils/user_repository.dart';
import '../utils/master_data_repository.dart';
import 'app_bottom_sheet.dart';
/// HOME タブビュー（AI生成表記＆画像ボトムシート対応）
class HomeView extends StatelessWidget {
  final AppDateResult? appDate;
  final HistoryMasterModel? historyMaster;
  const HomeView({
    super.key,
    required this.appDate,
    required this.historyMaster,
  });
  Future<void> _showDescriptionBottomSheet(BuildContext context) async {
    final l10n = AppLocalizations.of(context)!;
    final langCode = Localizations.localeOf(context).languageCode;
    final descText = historyMaster != null
        ? historyMaster!.getDescription(langCode)
        : l10n.homeDefaultDescription;
    final dateTitle =
        appDate != null ? appDate!.toLocalizedFormattedString(context) : '';
    final imagePath = historyMaster?.backgroundImagePath ?? '';
    String imageTitle = historyMaster?.getTitle(langCode) ?? '';
    // 🌟 画像タイトルが未取得の場合はキャッシュ/マスターから事前に取得（ボトムシート表示中の不要な再ビルドとカクつきを完全防止）
    if (imageTitle.isEmpty && historyMaster != null && historyMaster!.id.isNotEmpty) {
      final currentUserId = FirebaseAuth.instance.currentUser?.uid;
      HistoryMasterModel? master;
      if (currentUserId != null) {
        master = await UserRepository().fetchAndRepairEraMetadata(
          userId: currentUserId,
          eraKey: historyMaster!.id,
        );
      } else {
        master = await MasterDataRepository().getHistoryMaster(historyMaster!.id);
      }
      if (master != null) {
        imageTitle = master.getTitle(langCode);
      }
    }
    if (!context.mounted) return;
    AppBottomSheet.show(
      context: context,
      title: dateTitle,
      description: descText,
      imagePath: imagePath,
      imageTitle: imageTitle,
      showAiNotice: true,
    );
  }
  @override
  Widget build(BuildContext context) {
    final isDarkMode = Theme.of(context).brightness == Brightness.dark;
    final dateLabel = appDate != null
        ? appDate!.toLocalizedFormattedString(context)
        : '720 BCE 06/28';
    final buttonBgColor = isDarkMode
        ? Colors.black.withOpacity(0.40)
        : Colors.white.withOpacity(0.40);
    final borderColor = isDarkMode
        ? Colors.white.withOpacity(0.20)
        : Colors.white.withOpacity(0.50);
    final contentColor = isDarkMode ? Colors.white : Colors.black87;
    return Align(
      alignment: Alignment.topCenter,
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 24.0),
        child: InkWell(
          onTap: () => _showDescriptionBottomSheet(context),
          borderRadius: BorderRadius.circular(20),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(20),
            child: BackdropFilter(
              filter: ImageFilter.blur(sigmaX: 10, sigmaY: 10),
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                decoration: BoxDecoration(
                  color: buttonBgColor,
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(color: borderColor),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(
                      Icons.directions_run,
                      color: isDarkMode
                          ? Colors.purpleAccent[100]
                          : Colors.deepPurple,
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    Text(
                      dateLabel,
                      style: TextStyle(
                        fontSize: 15,
                        fontWeight: FontWeight.bold,
                        color: contentColor,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}
</file>

<file path="lib/widgets/side_menu_view.dart">
import 'dart:ui';
import 'package:flutter/material.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:google_sign_in/google_sign_in.dart';
import '../l10n/app_localizations.dart';
import '../main.dart';
import '../models/user_model.dart';
import '../utils/background_fetch_service.dart';
import '../pages/hall_of_fame_page.dart';
import '../pages/initial_page.dart';
import '../utils/step_tracker_service.dart';
import '../utils/user_repository.dart';
class SideMenuView extends StatefulWidget {
  final User? user;
  final UserModel? userData;
  final UserDetailedData? detailedData;
  final String? bgImageUrl;
  const SideMenuView({
    super.key,
    required this.user,
    required this.userData,
    this.detailedData,
    this.bgImageUrl,
  });
  @override
  State<SideMenuView> createState() => _SideMenuViewState();
}
class _SideMenuViewState extends State<SideMenuView> {
  late String _displayName;
  final UserRepository _userRepository = UserRepository();
  @override
  void initState() {
    super.initState();
    _displayName = widget.user?.displayName ?? 'Traveler';
  }
  Future<void> _showEditDisplayNameDialog(BuildContext context) async {
    final l10n = AppLocalizations.of(context)!;
    final controller = TextEditingController(text: _displayName);
    final newName = await showDialog<String>(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text(l10n.menuChangeNicknameTitle),
          content: TextField(
            controller: controller,
            autofocus: true,
            decoration: InputDecoration(
              hintText: l10n.menuChangeNicknameHint,
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: Text(l10n.menuCancel),
            ),
            ElevatedButton(
              onPressed: () => Navigator.pop(context, controller.text.trim()),
              child: Text(l10n.menuSave),
            ),
          ],
        );
      },
    );
    if (newName != null && newName.isNotEmpty && newName != _displayName) {
      try {
        await widget.user?.updateDisplayName(newName);
        await widget.user?.reload();
        setState(() {
          _displayName = newName;
        });
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text(l10n.menuNicknameUpdated)),
          );
        }
      } catch (e) {
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text(l10n.menuNicknameUpdateFailed(e.toString()))),
          );
        }
      }
    }
  }
  /// 🚪 ログアウト確認ダイアログ＆安全なログアウト処理（厳格な保存確認つき）
  Future<void> _handleLogout(BuildContext context) async {
    final l10n = AppLocalizations.of(context)!;
    final isDarkMode = Theme.of(context).brightness == Brightness.dark;
    final dialogBgColor = isDarkMode
        ? Colors.black.withOpacity(0.80)
        : Colors.white.withOpacity(0.90);
    final borderColor = isDarkMode
        ? Colors.white.withOpacity(0.20)
        : Colors.white.withOpacity(0.50);
    final textColor = isDarkMode ? Colors.white : Colors.black87;
    final navigator = Navigator.of(context, rootNavigator: true);
    final scaffoldMessenger = ScaffoldMessenger.of(context);
    final bool? shouldLogout = await showDialog<bool>(
      context: context,
      builder: (context) {
        return BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 10, sigmaY: 10),
          child: AlertDialog(
            backgroundColor: dialogBgColor,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(20),
              side: BorderSide(color: borderColor),
            ),
            title: Text(
              l10n.logoutDialogTitle,
              style: TextStyle(color: textColor, fontWeight: FontWeight.bold),
            ),
            content: Text(
              l10n.logoutDialogMessage,
              style: TextStyle(color: textColor, fontSize: 13, height: 1.5),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context, false),
                child: Text(l10n.logoutCancelButton),
              ),
              ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.redAccent,
                  foregroundColor: Colors.white,
                ),
                onPressed: () => Navigator.pop(context, true),
                child: Text(l10n.logoutConfirmButton),
              ),
            ],
          ),
        );
      },
    );
    if (shouldLogout != true) return;
    if (!mounted) return;
    // ローディング表示（rootNavigator を使用して確実に管理）
    showDialog(
      context: context,
      barrierDismissible: false,
      useRootNavigator: true,
      builder: (_) => const PopScope(
        canPop: false,
        child: Center(child: CircularProgressIndicator()),
      ),
    );
    try {
      // 1. 歩数保存を厳格に実行（タイムアウト4秒）
      if (widget.user != null && widget.userData != null) {
        print('⏳ [Logout] 歩数データの保存を開始します...');
        await _userRepository.saveStepsOnLogout(
          userId: widget.user!.uid,
          todaySteps: widget.userData!.steps,
          totalSteps: widget.userData!.totalSteps,
        ).timeout(const Duration(seconds: 4));
        print('✅ [Logout] 歩数データの保存に成功しました！');
      }
      // 2. トラッキングの安全停止
      StepTrackerService.stopTracking();
      await BackgroundFetchService.stop();
      // 3. サインアウト処理
      await Future.wait([
        FirebaseAuth.instance.signOut(),
        GoogleSignIn().signOut(),
      ]).timeout(const Duration(seconds: 4));
      // 4. ローディングモーダルを閉じる
      navigator.pop();
      // 5. ログイン・初期画面へ完全に画面スタックを一掃して遷移
      navigator.pushAndRemoveUntil(
        MaterialPageRoute(builder: (_) => const InitialPage()),
        (route) => false,
      );
    } catch (e) {
      print('❌ [Logout Failure] 保存またはサインアウト失敗: $e');
      // エラー発生時はローディングを解除して失敗メッセージを表示
      navigator.pop(); // ローディングポップアップを閉じる
      scaffoldMessenger.showSnackBar(
        SnackBar(
          content: Text('データの保存に失敗したためログアウトを中止しました。通信環境をご確認ください: ${e.toString()}'),
          backgroundColor: Colors.redAccent,
          duration: const Duration(seconds: 4),
        ),
      );
    }
  }
  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final isDarkMode = Theme.of(context).brightness == Brightness.dark;
    final currentTheme = themeModeNotifier.value;
    final currentLocale =
        localeNotifier.value ?? Localizations.localeOf(context);
    final drawerBgColor = isDarkMode
        ? Colors.black.withOpacity(0.55)
        : Colors.white.withOpacity(0.65);
    final borderColor = isDarkMode
        ? Colors.white.withOpacity(0.15)
        : Colors.white.withOpacity(0.40);
    final textColor = isDarkMode ? Colors.white : Colors.black87;
    final subTextColor = isDarkMode ? Colors.white70 : Colors.black54;
    return Drawer(
      backgroundColor: Colors.transparent,
      elevation: 0,
      child: ClipRRect(
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 15, sigmaY: 15),
          child: Container(
            decoration: BoxDecoration(
              color: drawerBgColor,
              border: Border(right: BorderSide(color: borderColor)),
            ),
            child: ListView(
              padding: EdgeInsets.zero,
              children: [
                SafeArea(
                  bottom: false,
                  child: Padding(
                    padding: const EdgeInsets.fromLTRB(20, 24, 16, 16),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            Expanded(
                              child: Text(
                                _displayName,
                                style: TextStyle(
                                  fontSize: 20,
                                  fontWeight: FontWeight.bold,
                                  color: textColor,
                                ),
                                overflow: TextOverflow.ellipsis,
                              ),
                            ),
                            IconButton(
                              icon: Icon(Icons.edit, size: 18, color: textColor),
                              onPressed: () => _showEditDisplayNameDialog(context),
                              tooltip: l10n.menuChangeNicknameTitle,
                            ),
                          ],
                        ),
                        const SizedBox(height: 4),
                        if (widget.userData?.startEra != null)
                          Text(
                            l10n.menuStartPoint(
                              widget.userData!.startEra,
                              widget.userData!.startYear,
                            ),
                            style: TextStyle(fontSize: 12, color: subTextColor),
                          ),
                        const SizedBox(height: 4),
                        SelectableText(
                          'UserID: ${widget.user?.uid ?? l10n.menuNotLoggedIn}',
                          style: TextStyle(fontSize: 11, color: subTextColor),
                        ),
                      ],
                    ),
                  ),
                ),
                Divider(color: borderColor),
                ListTile(
                  leading: Icon(Icons.directions_walk, color: textColor),
                  title: Text(l10n.menuTodaySteps, style: TextStyle(color: textColor)),
                  trailing: Text(
                    '${widget.userData?.steps ?? 0}',
                    style: TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 16,
                        color: textColor),
                  ),
                ),
                if (widget.userData?.isCleared == true)
                  ListTile(
                    leading: const Icon(Icons.emoji_events, color: Colors.amber),
                    title: Text(l10n.menuAllConquered,
                        style: const TextStyle(color: Colors.amber)),
                    trailing: Text(
                      '${widget.userData?.totalSteps ?? 0}',
                      style: const TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 16,
                          color: Colors.amber),
                    ),
                  )
                else
                  ListTile(
                    leading: Icon(Icons.timeline, color: textColor),
                    title: Text(l10n.menuTotalSteps, style: TextStyle(color: textColor)),
                    trailing: Text(
                      '${widget.userData?.totalSteps ?? 0}',
                      style: TextStyle(
                          fontWeight: FontWeight.bold, color: textColor),
                    ),
                  ),
                Divider(color: borderColor),
                ListTile(
                  leading: const Icon(Icons.account_balance, color: Colors.amberAccent),
                  title: Text(
                    l10n.hallOfFameTitle,
                    style: TextStyle(
                      color: textColor,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  trailing: Icon(
                    Icons.arrow_forward_ios,
                    size: 14,
                    color: subTextColor,
                  ),
                  onTap: () {
                    Navigator.pop(context); // サイドメニューを閉じる
                    Navigator.push(
                      context,
                      MaterialPageRoute(
                        builder: (_) => HallOfFamePage(
                          detailedData: widget.detailedData,
                          bgImageUrl: widget.bgImageUrl,
                        ),
                      ),
                    );
                  },
                ),
                Divider(color: borderColor),
                Padding(
                  padding: const EdgeInsets.symmetric(
                      horizontal: 16.0, vertical: 8.0),
                  child: Text(
                    l10n.menuThemeSection,
                    style: TextStyle(color: subTextColor, fontSize: 12),
                  ),
                ),
                ListTile(
                  leading: Icon(
                    currentTheme == ThemeMode.dark
                        ? Icons.dark_mode
                        : Icons.light_mode,
                    color: textColor,
                  ),
                  title: Text(l10n.menuDarkMode, style: TextStyle(color: textColor)),
                  trailing: Switch(
                    value: isDarkMode,
                    onChanged: (bool value) {
                      setState(() {
                        themeModeNotifier.value =
                            value ? ThemeMode.dark : ThemeMode.light;
                      });
                    },
                  ),
                ),
                Divider(color: borderColor),
                Padding(
                  padding: const EdgeInsets.symmetric(
                      horizontal: 16.0, vertical: 8.0),
                  child: Text(
                    l10n.menuLanguageSection,
                    style: TextStyle(color: subTextColor, fontSize: 12),
                  ),
                ),
                RadioListTile<String>(
                  title: Text('日本語', style: TextStyle(color: textColor)),
                  value: 'ja',
                  groupValue: currentLocale.languageCode,
                  onChanged: (value) {
                    if (value != null) {
                      setState(() {
                        localeNotifier.value = Locale(value);
                      });
                    }
                  },
                ),
                RadioListTile<String>(
                  title: Text('English', style: TextStyle(color: textColor)),
                  value: 'en',
                  groupValue: currentLocale.languageCode,
                  onChanged: (value) {
                    if (value != null) {
                      setState(() {
                        localeNotifier.value = Locale(value);
                      });
                    }
                  },
                ),
                Divider(color: borderColor),
                ListTile(
                  leading: const Icon(Icons.logout, color: Colors.redAccent),
                  title: Text(l10n.menuLogOut,
                      style: const TextStyle(color: Colors.redAccent)),
                  onTap: () => _handleLogout(context),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
</file>

