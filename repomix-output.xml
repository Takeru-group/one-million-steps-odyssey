import 'package:flutter/widgets.dart';
import '../l10n/app_localizations.dart';

/// 計算結果を保持するデータモデル
class AppDateResult {
  final String era; // '紀元前' または '西暦' (または 'BCE' / 'CE')
  final int year; // 年（例: 713）
  final int month; // 月（例: 9）
  final int day; // 日（例: 13）

  AppDateResult({
    required this.era,
    required this.year,
    required this.month,
    required this.day,
  });

  /// 表示用フォーマット (例: "紀元前713年9月13日")
  String toJapaneseString() => '$era${year}年$month月$day日';

  /// 🌐 多言語（l10n）対応の表示フォーマット
  String toLocalizedFormattedString(BuildContext context) {
    final l10n = AppLocalizations.of(context);
    if (l10n == null) return toJapaneseString();

    if (era == '紀元前' || era == 'BCE') {
      return l10n.dateBceFormat(year, month, day);
    } else {
      return l10n.dateCeFormat(year, month, day);
    }
  }

  /// ISO風フォーマット (例: "BCE 0713-09-13" や "CE 2026-08-11")
  String toIsoFormat() {
    final eraCode = (era == '紀元前' || era == 'BCE') ? 'BCE' : 'CE';
    return '$eraCode ${year.toString().padLeft(4, '0')}-${month.toString().padLeft(2, '0')}-${day.toString().padLeft(2, '0')}';
  }

  /// 世紀（int）を算出（1年〜100年 ➔ 1世紀、前1年〜前100年 ➔ 前1世紀）
  int get century {
    final c = ((year - 1) ~/ 100) + 1;
    return (era == '紀元前' || era == 'BCE') ? -c : c;
  }

  /// 10年単位の年代（Decade）表示用ラベル生成（例: 前109年 ➔ BC100年代）
  String get eraLabel {
    final isBce = (era == '紀元前' || era == 'BCE');
    final prefix = isBce ? 'BC' : 'AD';
    final roundedYear = (year ~/ 10) * 10;
    return '$prefix$roundedYear';
  }

  @override
  String toString() => toJapaneseString();
}

/// タイムライン・日付計算ロジックをまとめたクラス
class TimelineCalculator {
  /// 1. 基準日（西暦）から1,000,000日前（アプリ開始日）を算出
  static AppDateResult calculateAppStartDate(
    DateTime baseDate, {
    int daysToSubtract = 1000000,
  }) {
    final currentJdn = _dateToJdn('西暦', baseDate.year, baseDate.month, baseDate.day);
    final targetJdn = currentJdn - daysToSubtract;
    return _jdnToAppDate(targetJdn);
  }

  /// 2. 指定した「紀元・年・月・日」から「歩数（または日数）」分進んだ日付を算出
  static AppDateResult addStepsToDate({
    required String era,
    required int year,
    required int month,
    required int day,
    required int steps,
    int stepsPerDay = 1,
  }) {
    final daysToAdd = steps ~/ stepsPerDay;

    return addDaysToDate(
      era: era,
      year: year,
      month: month,
      day: day,
      daysToAdd: daysToAdd,
    );
  }

  /// 3. 指定した「紀元・年・月・日」から「指定日数」進んだ日付を直接算出
  static AppDateResult addDaysToDate({
    required String era,
    required int year,
    required int month,
    required int day,
    required int daysToAdd,
  }) {
    final baseJdn = _dateToJdn(era, year, month, day);
    final targetJdn = baseJdn + daysToAdd;
    return _jdnToAppDate(targetJdn);
  }

  // --- 内部ヘルパー関数 (JDNアルゴリズム - 天文学的0年補正含む) ---

  /// 日付 ➔ ユリウス日(JDN) 変換（西暦1年の前日は紀元前1年）
  static int _dateToJdn(String era, int year, int month, int day) {
    final rawYear = (era == '紀元前' || era == 'BCE') ? -(year - 1) : year;
    final a = (14 - month) ~/ 12;
    final y = rawYear + 4800 - a;
    final m = month + 12 * a - 3;
    return day + (153 * m + 2) ~/ 5 + 365 * y + y ~/ 4 - y ~/ 100 + y ~/ 400 - 32045;
  }

  /// ユリウス日(JDN) ➔ AppDateResult 変換
  static AppDateResult _jdnToAppDate(int jdn) {
    final f = jdn + 1401 + (((4 * jdn + 274274) ~/ 146097) * 3) ~/ 4 - 38;
    final e = 4 * f + 3;
    final g = (e % 1461) ~/ 4;
    final h = 5 * g + 2;

    final resDay = (h % 153) ~/ 5 + 1;
    final resMonth = (h ~/ 153 + 2) % 12 + 1;
    final rawYear = (e ~/ 1461) - 4716 + (12 + 2 - resMonth) ~/ 12;

    final era = (rawYear <= 0) ? '紀元前' : '西暦';
    final resYear = (rawYear <= 0) ? rawYear.abs() + 1 : rawYear;

    return AppDateResult(
      era: era,
      year: resYear,
      month: resMonth,
      day: resDay,
    );
  }
}
</file>

<file path="lib/utils/user_repository.dart">
import 'dart:math';
import 'package:cloud_firestore/cloud_firestore.dart';
import '../models/artifact_model.dart';
import '../models/history_master_model.dart';
import '../models/user_model.dart';
import 'master_data_repository.dart';
import 'timeline_calculator.dart';

class UserDetailedData {
  final UserModel user;
  final Map<String, HistoryMasterModel> unlockedHistories;
  final Map<String, ArtifactModel> unlockedArtifacts;

  UserDetailedData({
    required this.user,
    required this.unlockedHistories,
    required this.unlockedArtifacts,
  });
}

class UserRepository {
  final FirebaseFirestore _firestore;
  final MasterDataRepository _masterDataRepository;

  UserRepository({
    FirebaseFirestore? firestore,
    MasterDataRepository? masterDataRepository,
  })  : _firestore = firestore ?? FirebaseFirestore.instance,
        _masterDataRepository = masterDataRepository ?? MasterDataRepository();

  Future<UserModel> getOrCreateUser(String userId) async {
    final docRef = _firestore.collection('user').doc(userId);

    DocumentSnapshot<Map<String, dynamic>>? docSnap;
    try {
      docSnap = await docRef.get().timeout(const Duration(seconds: 3));
    } catch (_) {
      docSnap = await docRef.get(const GetOptions(source: Source.cache));
    }

    if (docSnap.exists && docSnap.data() != null) {
      return UserModel.fromDocument(userId, docSnap.data()!);
    }

    final now = DateTime.now().toUtc();
    final startAppDate = TimelineCalculator.calculateAppStartDate(now);

    final scheduledDeletionAt = DateTime(
      now.year + 1,
      now.month,
      now.day,
      now.hour,
      now.minute,
      now.second,
    );

    final initialEraKey = calculateEraKey(startAppDate.era, startAppDate.year);
    final initialEras = <String, Map<String, dynamic>>{
      initialEraKey: {
        'unlockedAt': Timestamp.fromDate(now),
        'eraLabel': startAppDate.eraLabel,
        'century': startAppDate.century,
        'gameMode': 0,
      }
    };

    final newUserData = <String, dynamic>{
      'appStartDate': Timestamp.fromDate(now),
      'stepFetchedAt': Timestamp.fromDate(now),
      'startEra': startAppDate.era,
      'startYear': startAppDate.year,
      'startMonth': startAppDate.month,
      'startDay': startAppDate.day,
      'isCleared': false,
      'gameMode': 0,
      'steps': 0,
      'totalSteps': 0,
      'scheduledDeletionAt': Timestamp.fromDate(scheduledDeletionAt),
      'unlockedArtifacts': <String, dynamic>{},
      'unlockedEras': initialEras,
    };

    try {
      await docRef.set(newUserData).timeout(const Duration(seconds: 3));
    } catch (e) {
      print('⚠️ [UserRepository] ネットワーク接続がないためローカル保存のみ行いました');
    }

    return UserModel.fromDocument(userId, newUserData);
  }

  Future<void> updateStepFetchTimestamp(String userId) async {
    final now = DateTime.now().toUtc();
    try {
      await _firestore.collection('user').doc(userId).update({
        'stepFetchedAt': Timestamp.fromDate(now),
      }).timeout(const Duration(seconds: 2));
    } catch (_) {}
  }

  Future<void> saveStepsOnLogout({
    required String userId,
    required int todaySteps,
    required int totalSteps,
  }) async {
    final now = DateTime.now().toUtc();
    try {
      await _firestore.collection('user').doc(userId).update({
        'steps': todaySteps,
        'totalSteps': totalSteps,
        'stepFetchedAt': Timestamp.fromDate(now),
      }).timeout(const Duration(seconds: 2));
    } catch (e) {
      print('⚠️ [Logout Save] 通信エラーのため保存をスキップして進めます: $e');
    }
  }

  Future<UserDetailedData> getUserWithDetails(String userId) async {
    final user = await getOrCreateUser(userId);

    final historyFutures = user.unlockedEras.keys.map((historyId) async {
      final master = await _masterDataRepository.getHistoryMaster(historyId);
      return MapEntry(historyId, master);
    });

    final artifactFutures = user.unlockedArtifacts.keys.map((artifactId) async {
      final artifact = await _masterDataRepository.getArtifact(artifactId);
      return MapEntry(artifactId, artifact);
    });

    final historyEntries = await Future.wait(historyFutures);
    final artifactEntries = await Future.wait(artifactFutures);

    final unlockedHistories = <String, HistoryMasterModel>{};
    for (final entry in historyEntries) {
      if (entry.value != null) {
        unlockedHistories[entry.key] = entry.value!;
      }
    }

    final unlockedArtifacts = <String, ArtifactModel>{};
    for (final entry in artifactEntries) {
      if (entry.value != null) {
        unlockedArtifacts[entry.key] = entry.value!;
      }
    }

    return UserDetailedData(
      user: user,
      unlockedHistories: unlockedHistories,
      unlockedArtifacts: unlockedArtifacts,
    );
  }

  Future<UserDetailedData> updateUserEraProgress({
    required String userId,
    required int newTotalSteps,
    required String newEraKey,
    required String eraLabel,
    required int century,
    required int currentGameMode,
  }) async {
    final docRef = _firestore.collection('user').doc(userId);
    final now = DateTime.now().toUtc();

    final newScheduledDeletionAt = DateTime(
      now.year + 1,
      now.month,
      now.day,
      now.hour,
      now.minute,
      now.second,
    );

    final eraData = {
      'unlockedAt': Timestamp.fromDate(now),
      'eraLabel': eraLabel,
      'century': century,
      'gameMode': currentGameMode,
    };

    try {
      await docRef.update({
        'stepFetchedAt': Timestamp.fromDate(now),
        'totalSteps': newTotalSteps,
        'scheduledDeletionAt': Timestamp.fromDate(newScheduledDeletionAt),
        'unlockedEras.$newEraKey': eraData,
      }).timeout(const Duration(seconds: 3));
    } catch (_) {}

    return await getUserWithDetails(userId);
  }

  Future<ArtifactModel?> unlockRandomArtifactForEra({
    required String userId,
    required String currentEraKey,
    required UserDetailedData currentDetails,
  }) async {
    final user = currentDetails.user;
    final currentDate = TimelineCalculator.addStepsToDate(
      era: user.startEra,
      year: user.startYear,
      month: user.startMonth,
      day: user.startDay,
      steps: user.totalSteps,
      stepsPerDay: 1,
    );
    final targetCentury = currentDate.century;

    QuerySnapshot<Map<String, dynamic>> snapshot;
    try {
      snapshot = await _firestore
          .collection('artifacts')
          .where('century', isEqualTo: targetCentury)
          .get()
          .timeout(const Duration(seconds: 3));
    } catch (_) {
      snapshot = await _firestore
          .collection('artifacts')
          .where('century', isEqualTo: targetCentury)
          .get(const GetOptions(source: Source.cache));
    }

    if (snapshot.docs.isEmpty) return null;

    final unlockedIds = currentDetails.user.unlockedArtifacts.keys.toSet();
    final uncollectedDocs = snapshot.docs.where((doc) {
      return !unlockedIds.contains(doc.id);
    }).toList();

    if (uncollectedDocs.isEmpty) return null;

    final random = Random();
    final selectedDoc = uncollectedDocs[random.nextInt(uncollectedDocs.length)];
    final artifactId = selectedDoc.id;

    final artifactMaster = await _masterDataRepository.getArtifact(artifactId);
    if (artifactMaster == null) return null;

    final now = DateTime.now().toUtc();
    final artifactData = {
      'unlockedAt': Timestamp.fromDate(now),
      'eraKey': currentEraKey,
      'gameMode': currentDetails.user.gameMode,
    };

    try {
      await _firestore.collection('user').doc(userId).update({
        'unlockedArtifacts.$artifactId': artifactData,
        'lastArtifactUnlockedAt': Timestamp.fromDate(now),
      }).timeout(const Duration(seconds: 3));
    } catch (_) {}

    return artifactMaster;
  }

  /// 🔑 紀元前1桁でも正しいキー（例: bc_0000 や bc_0090）を生成する統一関数
  static String calculateEraKey(String era, int year) {
    final isBce = (era == '紀元前' || era == 'BCE');
    final roundedYear = (year ~/ 10) * 10;

    final prefix = isBce ? 'bc_' : 'ad_';
    final paddedYear = roundedYear.toString().padLeft(4, '0');
    return '$prefix$paddedYear';
  }
}
