import 'dart:io';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_storage/firebase_storage.dart';
import 'package:flutter_cache_manager/flutter_cache_manager.dart';

import '../models/artifact_model.dart';
import '../models/history_master_model.dart';

class MasterDataRepository {
  final FirebaseFirestore _firestore;
  final FirebaseStorage _storage;
  final BaseCacheManager _cacheManager;

  static final Map<String, String> _urlMemoryCache = {};

  MasterDataRepository({
    FirebaseFirestore? firestore,
    FirebaseStorage? storage,
    BaseCacheManager? cacheManager,
  })  : _firestore = firestore ?? FirebaseFirestore.instance,
        _storage = storage ?? FirebaseStorage.instance,
        _cacheManager = cacheManager ?? DefaultCacheManager();

  Future<String> resolveImageUrl(String path) async {
    if (path.isEmpty || path == 'EXCLUDED') return '';
    if (path.startsWith('http://') || path.startsWith('https://')) {
      return path;
    }

    if (_urlMemoryCache.containsKey(path)) {
      return _urlMemoryCache[path]!;
    }

    try {
      final ref = _storage.ref(path);
      final downloadUrl = await ref.getDownloadURL().timeout(const Duration(seconds: 2));
      _urlMemoryCache[path] = downloadUrl;

      _backgroundEnsureDiskCache(downloadUrl);

      return downloadUrl;
    } catch (e) {
      print('⚠️ [Storage URL 取得失敗 / オフライン]: $path');
      return _urlMemoryCache[path] ?? '';
    }
  }

  void _backgroundEnsureDiskCache(String httpUrl) async {
    if (httpUrl.isEmpty || !httpUrl.startsWith('http')) return;
    try {
      final FileInfo? fileInfo = await _cacheManager.getFileFromCache(httpUrl);
      if (fileInfo == null || !(await fileInfo.file.exists())) {
        await _cacheManager.getSingleFile(httpUrl);
      }
    } catch (_) {}
  }

  Future<HistoryMasterModel?> getHistoryMaster(String historyId) async {
    DocumentSnapshot<Map<String, dynamic>> docSnap;
    try {
      docSnap = await _firestore.collection('history_master').doc(historyId).get().timeout(const Duration(seconds: 2));
    } catch (_) {
      docSnap = await _firestore.collection('history_master').doc(historyId).get(const GetOptions(source: Source.cache));
    }

    if (!docSnap.exists || docSnap.data() == null) return null;

    final data = Map<String, dynamic>.from(docSnap.data()!);

    data['backgroundImagePath'] =
        await resolveImageUrl(data['backgroundImagePath'] as String? ?? '');
    data['thumbnailPath'] =
        await resolveImageUrl(data['thumbnailPath'] as String? ?? '');

    return HistoryMasterModel.fromDocument(historyId, data);
  }

  Future<ArtifactModel?> getArtifact(String artifactId) async {
    DocumentSnapshot<Map<String, dynamic>> docSnap;
    try {
      docSnap = await _firestore.collection('artifacts').doc(artifactId).get().timeout(const Duration(seconds: 2));
    } catch (_) {
      docSnap = await _firestore.collection('artifacts').doc(artifactId).get(const GetOptions(source: Source.cache));
    }

    if (!docSnap.exists || docSnap.data() == null) return null;

    final data = Map<String, dynamic>.from(docSnap.data()!);

    data['backgroundImagePath'] =
        await resolveImageUrl(data['backgroundImagePath'] as String? ?? '');
    data['thumbnailPath'] =
        await resolveImageUrl(data['thumbnailPath'] as String? ?? '');

    return ArtifactModel.fromDocument(artifactId, data);
  }
}
</file>

<file path="lib/utils/step_tracker_service.dart">
import 'dart:async';
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter_local_notifications/flutter_local_notifications.dart';
import 'package:health/health.dart';

class StepTrackerService {
  static final Health _health = Health();
  static final FlutterLocalNotificationsPlugin _notifications =
      FlutterLocalNotificationsPlugin();
  static Timer? _timer;
  static int _lastCheckedDay = -1;

  static Future<void> initialize() async {
    if (kIsWeb) return;

    const androidSettings =
        AndroidInitializationSettings('@mipmap/ic_launcher');
    const iosSettings = DarwinInitializationSettings(
      requestAlertPermission: true,
      requestBadgePermission: true,
      requestSoundPermission: true,
    );

    const settings = InitializationSettings(
      android: androidSettings,
      iOS: iosSettings,
    );

    await _notifications.initialize(settings: settings);
  }

  /// 定期トラッキング（30秒おき）
  static void startForegroundTracking({
    required BuildContext context,
    required DateTime stepFetchedAt,
    required Function(int incrementalSteps, int todaySteps) onStepsUpdated,
    required Function(List<Map<String, dynamic>> weeklySteps) onWeeklyUpdated,
  }) {
    if (kIsWeb) return;

    _timer?.cancel();
    _lastCheckedDay = DateTime.now().day;

    // 初回フェッチ
    _fetchStepData(stepFetchedAt, onStepsUpdated);

    // 30秒おきに繰り返し更新
    _timer = Timer.periodic(const Duration(seconds: 30), (_) async {
      final now = DateTime.now();

      // 1. 今日の歩数 ＆ 保存日時からの増分歩数
      _fetchStepData(stepFetchedAt, onStepsUpdated);

      // 2. 日付を跨いだ時のみ「過去7日間の歩数」を更新
      if (now.day != _lastCheckedDay) {
        _lastCheckedDay = now.day;
        print('📅 [StepTracker] 日時跨ぎを検知。過去7日間の歩数を再取得します。');
        final weekly = await fetchPastWeeklySteps();
        onWeeklyUpdated(weekly);
      }
    });
  }

  static void stopTracking() {
    _timer?.cancel();
  }

  /// 1. 本日の歩数（保存なし） ＆ 2. 保存日時からの増分歩数を算出
  static Future<void> _fetchStepData(
    DateTime stepFetchedAt,
    Function(int incrementalSteps, int todaySteps) onStepsUpdated,
  ) async {
    if (kIsWeb) return;

    try {
      final now = DateTime.now();
      final todayMidnight = DateTime(now.year, now.month, now.day, 0, 0, 0);

      // ① 1日の歩数: 本日 00:00:00 〜 現在 (保存なし)
      final today =
          await _health.getTotalStepsInInterval(todayMidnight, now) ?? 0;

      // ② 増分歩数: 最終保存日時 (stepFetchedAt) 〜 現在
      // ※ 未来時刻や過去のズレを防止するため、stepFetchedAt が now より未来なら 0
      final fetchFrom = stepFetchedAt.isAfter(now) ? now : stepFetchedAt;
      final incremental =
          await _health.getTotalStepsInInterval(fetchFrom, now) ?? 0;

      onStepsUpdated(incremental, today);
    } catch (e) {
      print('⚠️ [StepTracker] 歩数取得エラー: $e');
    }
  }

  /// 3. 過去7日間の歩数 (アプリ開いた時・日跨ぎ時のみ取得)
  static Future<List<Map<String, dynamic>>> fetchPastWeeklySteps() async {
    if (kIsWeb) return [];

    final List<Map<String, dynamic>> weeklyData = [];
    final now = DateTime.now();

    try {
      for (int i = 6; i >= 0; i--) {
        final targetDate = now.subtract(Duration(days: i));
        
        final startOfDay =
            DateTime(targetDate.year, targetDate.month, targetDate.day, 0, 0, 0);

        final endOfDay = (i == 0)
            ? now
            : DateTime(targetDate.year, targetDate.month, targetDate.day, 23, 59, 59);

        final steps =
            await _health.getTotalStepsInInterval(startOfDay, endOfDay) ?? 0;

        weeklyData.add({
          'dayLabel': '${targetDate.month}/${targetDate.day}',
          'steps': steps,
        });
      }
    } catch (e) {
      print('⚠️ [StepTracker] 過去7日間の歩数取得エラー: $e');
    }

    return weeklyData;
  }
}
</file>

